# Copier ce fichier en ".env" (même dossier serveur/) puis adapter.
# Ne jamais versionner ni partager le fichier ".env". Ce fichier-ci est un modèle de DÉVELOPPEMENT.
# Toutes les variables sont lues par app/core/config.py avec le préfixe BE_ (champ = nom en minuscules).
# Les valeurs ci-dessous sont les valeurs par défaut de config.py, sauf indication contraire.
# Une ligne commentée (#) = valeur par défaut, décommenter seulement pour la changer.

# --- Environnement -----------------------------------------------------------------
# Valeurs : local | test | production. En local, la base est créée et des comptes de démo sont provisionnés.
BE_ENVIRONNEMENT=local

# Base de données. SQLite en local (chemin relatif au dossier serveur/).
# En ligne, utiliser PostgreSQL : postgresql+psycopg://utilisateur:motdepasse@hote:5432/base
BE_URL_BASE_DONNEES=sqlite:///./donnees/bureau.db

# Affichage de la documentation interactive /docs et /openapi.json.
# Vide = actif hors production, inactif en production.
# BE_DOCS_API_ACTIVES=true

# Niveau des journaux : DEBUG, INFO, WARNING, ERROR
BE_NIVEAU_JOURNAL=INFO

# --- Sessions et cookies -----------------------------------------------------------
# En local sur http://127.0.0.1 : false. En production (HTTPS) : OBLIGATOIREMENT true.
BE_COOKIE_SECURISE=false
# BE_NOM_COOKIE_SESSION=be_session
# Durée maximale d'une session (minutes, 5 à 10080)
BE_DUREE_SESSION_MINUTES=480
# Expiration après inactivité (minutes, 5 à 1440)
BE_INACTIVITE_SESSION_MINUTES=120

# --- Mots de passe et protection contre les essais ----------------------------------
# BE_LONGUEUR_MIN_MOT_DE_PASSE=12
BE_MAX_ECHECS_CONNEXION=5
BE_DUREE_VERROUILLAGE_MINUTES=15

# --- Chiffrement au repos ----------------------------------------------------------
# Clé maîtresse de 32 octets en Base64 urlsafe. Si vide : Windows utilise DPAPI
# (fichier serveur/donnees/cle_maitresse.dpapi créé automatiquement). Sur Linux, elle est obligatoire.
# Générer : python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# BE_CLE_MAITRESSE_BASE64=
# BE_FICHIER_CLE_DPAPI=  (Windows uniquement, chemin du fichier DPAPI ; défaut serveur/donnees/cle_maitresse.dpapi)
# BE_TAILLE_MAX_DOCUMENT_OCTETS=15728640
# BE_DUREE_VERROU_DOSSIER_SECONDES=300

# --- Stockage (chemins absolus facultatifs ; défauts relatifs à serveur/donnees/) ----
# BE_DOSSIER_STOCKAGE=
# BE_DOSSIER_SAUVEGARDES=
# BE_DOSSIER_DEMARCHES=   (défaut : config/demarches à la racine du dépôt)
# BE_DOSSIER_PORTAILS=    (défaut : config/portails à la racine du dépôt)

# --- Conformité ---------------------------------------------------------------------
# BE_VERSION_CGU_COURANTE=CGU-2026.10
# BE_VERSION_CONSENTEMENT_LOI_18_07=L18-07-2026.1

# --- Facturation Stripe (facultatif en local) ---------------------------------------
# Secret du webhook Stripe (whsec_...). Défaut de développement : inutilisable en production.
# BE_STRIPE_SECRET_WEBHOOK=
# Clé secrète Stripe : réservée, non encore utilisée par le code.
# BE_STRIPE_CLE_SECRETE=

# --- Assistant IA (Claude) : facultatif ----------------------------------------------
# Sans clé, les fonctions IA répondent 503 et le reste de la plateforme fonctionne.
# BE_CLE_API_ANTHROPIC=
# BE_MODELE_LLM=claude-sonnet-5-5
# BE_URL_API_ANTHROPIC=https://api.anthropic.com/v1/messages
# BE_DELAI_LLM_SECONDES=90
