# Copier ce fichier en ".env" (même dossier) puis adapter.
# Ne jamais versionner ni partager le fichier ".env".

# local | test | production
BE_ENVIRONNEMENT=local

# SQLite en local (chemin relatif au dossier "serveur"). En ligne : postgresql+psycopg://...
BE_URL_BASE_DONNEES=sqlite:///./donnees/bureau.db

# En local sur http://127.0.0.1 : false. En production (HTTPS) : obligatoirement true.
BE_COOKIE_SECURISE=false

# Durée maximale d'une session (minutes) et expiration après inactivité (minutes)
BE_DUREE_SESSION_MINUTES=480
BE_INACTIVITE_SESSION_MINUTES=120

# Protection contre les essais de mots de passe
BE_MAX_ECHECS_CONNEXION=5
BE_DUREE_VERROUILLAGE_MINUTES=15

BE_NIVEAU_JOURNAL=INFO
