# MODÈLE de fichier d'environnement de PRODUCTION.
# 1. Copier ce fichier : cp .env.production.exemple .env.production   (dans le dossier deploiement/)
# 2. Remplacer chaque valeur <ENTRE_CHEVRONS> par une vraie valeur. Ne jamais committer .env.production.
# 3. Les secrets ne doivent figurer que dans .env.production (ignoré par Git et par Docker).
# Guide pas à pas : docs/DEPLOIEMENT.md

# === Domaine et HTTPS (Caddy) =========================================================
# Nom de domaine public dont l'enregistrement DNS pointe vers ce serveur.
DOMAINE_PLATEFORME=<app.votre-domaine.dz>
# Adresse e-mail pour les avis d'expiration Let's Encrypt.
EMAIL_CERTIFICAT_TLS=<securite@votre-domaine.dz>

# === Base PostgreSQL (lue par docker-compose ; BE_URL_BASE_DONNEES est construite automatiquement) ===
POSTGRES_DB=agent_bureau
POSTGRES_USER=agent_bureau
# Mot de passe long et aléatoire. S'il contient @ : / ? # % , il faut le encoder en URL (%40, %3A, etc.).
POSTGRES_PASSWORD=<mot-de-passe-postgres-long-et-aleatoire>

# === Environnement applicatif (BE_*) ==================================================
# Ne pas modifier BE_ENVIRONNEMENT ni BE_COOKIE_SECURISE : fixés à production / true dans docker-compose.
# Clé maîtresse de chiffrement, 32 octets en Base64 urlsafe. OBLIGATOIRE. Voir docs/DEPLOIEMENT.md.
# Générer : python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Conserver une copie hors serveur (coffre-fort papier ou gestionnaire de mots de passe) : sans elle, les données sont irrécupérables.
BE_CLE_MAITRESSE_BASE64=<cle-maitresse-32-octets-base64>

# Affichage de /docs (documentation API). Laisser false en production.
BE_DOCS_API_ACTIVES=false
# Niveau des journaux : INFO (recommandé), WARNING ou ERROR.
BE_NIVEAU_JOURNAL=INFO

# Sessions : durée maximale et expiration après inactivité (minutes).
BE_NOM_COOKIE_SESSION=be_session
BE_DUREE_SESSION_MINUTES=480
BE_INACTIVITE_SESSION_MINUTES=120

# Mots de passe et protection contre les essais de connexion.
BE_LONGUEUR_MIN_MOT_DE_PASSE=12
BE_MAX_ECHECS_CONNEXION=5
BE_DUREE_VERROUILLAGE_MINUTES=15

# Taille maximale d'un document téléversé, en octets (15 728 640 = 15 MiB).
BE_TAILLE_MAX_DOCUMENT_OCTETS=15728640
# Durée du verrou exclusif sur un dossier pendant une tâche longue (secondes).
BE_DUREE_VERROU_DOSSIER_SECONDES=300

# Versions des textes juridiques imposées lors de l'acceptation (à mettre à jour si les textes changent).
BE_VERSION_CGU_COURANTE=CGU-2026.10
BE_VERSION_CONSENTEMENT_LOI_18_07=L18-07-2026.1

# === Navigateur de l'agent en ligne (Chromium headless) — facultatif ====================
# Voir docs/DEPLOIEMENT.md, section « Navigateur de l'agent en ligne ». Désactivé par défaut.
BE_NAVIGATEUR_SERVEUR_ACTIF=false
# Sessions simultanées maximales (une par bureau) : prévoir environ 500 Mo de mémoire par session.
BE_NAVIGATEUR_SERVEUR_SESSIONS_MAX=3
# Fermeture automatique d'une session inactive (minutes).
BE_NAVIGATEUR_SERVEUR_INACTIVITE_MINUTES=15
# Limites du conteneur serveur (mémoire : 1 Go de base + 500 Mo par session).
SERVEUR_LIMITE_MEMOIRE=3g
SERVEUR_LIMITE_CPU=2.0

# === URL publique, inscriptions et abonnement ==========================================
# L'URL publique (https://DOMAINE_PLATEFORME) est fixée automatiquement par docker-compose.
# Inscription libre-service des agences : true (ouverte) ou false (comptes créés par l'administrateur via la CLI).
BE_INSCRIPTIONS_OUVERTES=true
# Durée de l'essai gratuit (jours) puis tolérance après impayé (jours) avant passage en lecture seule.
BE_DUREE_ESSAI_JOURS=30
BE_JOURS_GRACE_IMPAYE=7

# === Courriels (SMTP) — À RENSEIGNER AVANT OUVERTURE AU PUBLIC ===========================
# Sans hôte ET expéditeur, rien n'est envoyé : pas de réinitialisation de mot de passe, pas de vérification
# d'adresse (or la validation humaine d'un récapitulatif l'exige en production). Valeurs d'exemple ci-dessous.
BE_COURRIEL_TRANSPORT=auto
BE_SMTP_HOTE=smtp.exemple.org
BE_SMTP_PORT=587
# starttls (port 587), ssl (port 465) ou aucune (déconseillé).
BE_SMTP_SECURITE=starttls
BE_SMTP_UTILISATEUR=
BE_SMTP_MOT_DE_PASSE=
# Adresse d'expédition authentifiée (SPF, DKIM, DMARC) sur votre domaine.
BE_SMTP_EXPEDITEUR=ne-pas-repondre@exemple.org

# === Stripe (facturation) =============================================================
# OBLIGATOIRE dans ce modèle : secret du webhook fourni par Stripe (commence par whsec_).
# Le défaut du code (whsec_dev_local_secret_change_me) est refusé en production.
BE_STRIPE_SECRET_WEBHOOK=<whsec_secret-du-webhook-stripe>
# Clé secrète API Stripe (sk_live_... ou sk_test_...). Vide = paiement en ligne indisponible en production.
BE_STRIPE_CLE_SECRETE=
# Identifiants de prix Stripe (price_...) de chaque forfait ; à créer dans le tableau de bord Stripe.
BE_STRIPE_PRIX_STARTER=
BE_STRIPE_PRIX_PROFESSIONNEL=
BE_STRIPE_PRIX_ENTREPRISE=

# === Assistant IA — facultatif ==========================================================
# Vide = fonctions IA désactivées (réponse 503), le reste fonctionne normalement.
BE_CLE_API_ANTHROPIC=
BE_MODELE_LLM=claude-sonnet-5-5
BE_URL_API_ANTHROPIC=https://api.anthropic.com/v1/messages
BE_DELAI_LLM_SECONDES=90
# IA alternative : anthropic (défaut) ou openai_compatible (Ollama, Groq, Mistral...). Voir docs/IA_GRATUITE.md.
BE_IA_FOURNISSEUR=anthropic
# Exemples (non secrets) si openai_compatible : http://127.0.0.1:11434/v1 et un nom de modèle.
BE_IA_URL_BASE=
BE_IA_MODELE=
BE_IA_CLE=
BE_IA_TENTATIVES=2

# === Sauvegardes (lues par deploiement/sauvegarde.sh, pas par docker-compose) ============
# Dossier de destination sur l'hôte, durée de conservation locale (jours) et copie distante facultative (rsync).
DEST_SAUVEGARDES=/opt/sauvegardes
RETENTION_JOURS=14
# Exemple : utilisateur@hote-distant:/chemin/sauvegardes/  (laisser vide pour désactiver)
COPIE_DISTANTE_RSYNC=
