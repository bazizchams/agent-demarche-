# Configuration Caddy 2 — HTTPS automatique (Let's Encrypt) + durcissement HTTP
# Variables lues depuis l'environnement du conteneur Caddy (voir docker-compose.production.yml) :
#   DOMAINE_PLATEFORME   : nom de domaine public pointant vers le serveur (enregistrement DNS A/AAAA)
#   EMAIL_CERTIFICAT_TLS : adresse e-mail pour les notifications Let's Encrypt
{
    email {$EMAIL_CERTIFICAT_TLS}
}

{$DOMAINE_PLATEFORME} {
    encode zstd gzip

    # En-têtes de sécurité envoyés au navigateur. Caddy les applique à toutes les réponses.
    header {
        # `preload` : n'a d'effet que si le domaine est soumis à la liste de préchargement HSTS
        # (engagement quasi irréversible, tous les sous-domaines en HTTPS). Retirer si doute.
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        # CSP partielle : n'impose pas de politique sur les scripts (l'interface utilise du JavaScript intégré)
        # mais interdit l'inclusion en cadre, les <base> et <object> détournés.
        Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        Cross-Origin-Opener-Policy "same-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        -Server
    }

    # Taille maximale des requêtes. Le serveur limite un document à 15 MiB
    # (BE_TAILLE_MAX_DOCUMENT_OCTETS) ; on laisse une marge pour l'enveloppe multipart.
    request_body {
        max_size 20MB
    }

    reverse_proxy serveur:8000
}
